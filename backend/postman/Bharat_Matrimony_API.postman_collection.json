{
  "info": {
    "name": "Bharat Matrimony API",
    "description": "Postman collection for the Bharat Matrimony PHP backend. Start backend at http://localhost:8080 and login first for protected APIs so Postman stores the session cookie.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"User@123\",\n  \"role\": \"user\"\n}"
            },
            "url": "{{base_url}}/auth/login.php"
          }
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@matrimony.local\",\n  \"password\": \"Admin@123\",\n  \"role\": \"admin\"\n}"
            },
            "url": "{{base_url}}/auth/login.php"
          }
        },
        {
          "name": "Current User",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/me.php"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/auth/logout.php"
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarita Sharma\",\n  \"email\": \"sarita@example.com\",\n  \"password\": \"Sarita@123\",\n  \"age\": 26,\n  \"height\": \"5ft 4in\",\n  \"city\": \"Delhi\",\n  \"religion\": \"Hindu\",\n  \"community\": \"Punjabi\",\n  \"profession\": \"Software Engineer\",\n  \"education\": \"B.Tech\",\n  \"income\": \"12 LPA\",\n  \"bio\": \"Family-oriented and looking for a meaningful connection.\",\n  \"photo\": \"https://example.com/profile.jpg\"\n}"
            },
            "url": "{{base_url}}/auth/register.php"
          }
        }
      ]
    },
    {
      "name": "Profiles",
      "item": [
        {
          "name": "Get Profiles",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/profiles/index.php"
          }
        },
        {
          "name": "Get Profiles With Filters",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/profiles/index.php?city=Mumbai&religion=Hindu&query=Doctor"
          }
        },
        {
          "name": "Update Logged-in Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Sarita Sharma\",\n  \"age\": 26,\n  \"height\": \"5ft 4in\",\n  \"city\": \"Mumbai\",\n  \"religion\": \"Hindu\",\n  \"community\": \"Punjabi\",\n  \"profession\": \"Doctor\",\n  \"education\": \"MBBS\",\n  \"income\": \"16 LPA\",\n  \"bio\": \"Family-oriented and looking for a meaningful connection.\",\n  \"photo\": \"https://example.com/profile-photo.jpg\",\n  \"intro_video\": \"https://example.com/intro-video.mp4\"\n}"
            },
            "url": "{{base_url}}/profiles/index.php"
          }
        },
        {
          "name": "Upload Media",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "type", "value": "photo", "type": "text" },
                { "key": "media", "type": "file", "src": "" }
              ]
            },
            "url": "{{base_url}}/media/index.php"
          }
        }
      ]
    },
